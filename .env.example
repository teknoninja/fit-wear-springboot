# ============================================================================
# Copy the CLIENT block into  client/.env
# Set the SERVER block in     Vercel -> Project -> Settings -> Environment Variables
# Never commit a filled-in .env — .gitignore already excludes it.
# ============================================================================


# ---------------------------------------------------------------------------
# CLIENT  (client/.env)
# Anything VITE_-prefixed is compiled into the JS bundle and is PUBLIC.
# Only put publishable/anon keys here.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API -> Project API keys -> anon / public
# Safe to expose: Row Level Security is what protects the data.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe -> Developers -> API keys -> Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx


# ---------------------------------------------------------------------------
# SERVER  (Vercel environment variables — NOT in client/.env)
# No VITE_ prefix, so Vite will not inline these into the bundle.
# ---------------------------------------------------------------------------

# Same URL as above.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API -> service_role key.
# SECRET. Bypasses Row Level Security completely. Server only — if this key
# ever reaches the browser, every user's data is readable and writable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe -> Developers -> API keys -> Secret key
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Sanity (used by the checkout + webhook functions)
VITE_SANITY_PROJECT_ID=y4feni72
VITE_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=your-sanity-write-token
